// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:../../../apps/shopify-app/prisma/dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id         String   @id @default(cuid())
  shopDomain String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  configuration  ShopConfiguration?
  customizations Customization[]
  rateRules      RateRule[]
}

model ShopConfiguration {
  id                     String   @id @default(cuid())
  shopId                 String   @unique
  shippingRatesEnabled   Boolean  @default(false)
  customizationsEnabled  Boolean  @default(false)
  autoProductSyncEnabled Boolean  @default(false)
  blendMode              String   @default("add")
  contactEmail           String?
  version                Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Customization {
  id             String   @id @default(cuid())
  shopId         String
  name           String
  type           String
  status         String   @default("DRAFT")
  parameterSet   Int
  conditionMatch String   @default("ALL")
  shipmentScope  String   @default("ALL")
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop       Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conditions CustomizationCondition[]
  methods    CustomizationMethod[]
  schedules  CustomizationSchedule[]

  @@unique([id, shopId])
  @@index([shopId, status])
}

model CustomizationSchedule {
  id              String   @id @default(cuid())
  shopId          String
  customizationId String
  position        Int
  action          String
  scheduledAt     DateTime
  timezone        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customization Customization @relation(fields: [customizationId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([customizationId, position])
  @@index([shopId, scheduledAt])
}

model CustomizationCondition {
  id              String   @id @default(cuid())
  shopId          String
  customizationId String
  position        Int
  field           String
  operator        String?
  key             String?
  value           String?
  productMatch    String?
  matchValue      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customization Customization @relation(fields: [customizationId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([customizationId, position])
  @@index([shopId])
}

model CustomizationMethod {
  id              String   @id @default(cuid())
  shopId          String
  customizationId String
  position        Int
  value           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customization Customization @relation(fields: [customizationId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([customizationId, position])
  @@index([shopId])
}

model RateRule {
  id             String   @id @default(cuid())
  shopId         String
  name           String
  priority       Int
  status         String   @default("DRAFT")
  conditionMatch String   @default("ALL")
  exclusivity    String   @default("INCLUSIVE")
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conditions RateCondition[]
  rates      RateDefinition[]
  schedules  RateSchedule[]

  @@unique([id, shopId])
  @@unique([shopId, priority])
  @@index([shopId, status])
}

model RateSchedule {
  id          String   @id @default(cuid())
  shopId      String
  rateRuleId  String
  position    Int
  action      String
  scheduledAt DateTime
  timezone    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rateRule RateRule @relation(fields: [rateRuleId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([rateRuleId, position])
  @@index([shopId, scheduledAt])
}

model RateCondition {
  id            String   @id @default(cuid())
  shopId        String
  rateRuleId    String
  position      Int
  field         String
  subfield      String?
  key           String?
  operator      String
  value         String?
  quantityCheck String?
  quantityValue String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rateRule RateRule @relation(fields: [rateRuleId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([rateRuleId, position])
  @@index([shopId])
}

model RateDefinition {
  id           String   @id @default(cuid())
  shopId       String
  rateRuleId   String
  position     Int
  zoneKey      String
  name         String
  calculation  String   @default("Fixed rate")
  price        Float?
  description  String?
  minimumDays  Int?
  maximumDays  Int?
  currencyCode String
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rateRule RateRule @relation(fields: [rateRuleId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([rateRuleId, position])
  @@index([shopId, zoneKey])
}
