{
  "name": "calculator-monorepo",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "web",
    "web/src/*"
  ],
  "scripts": {
    "build": "npm run database:generate && turbo run build",
    "dev": "shopify app dev",
    "start": "npm run start --workspace=@calculator/shopify-app",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "shopify": "shopify app",
    "shopify:info": "shopify app info",
    "shopify:build": "shopify app build",
    "shopify:deploy": "shopify app deploy",
    "database:generate": "prisma generate --schema web/src/database/prisma/schema.prisma",
    "database:migrate": "prisma migrate deploy --schema web/src/database/prisma/schema.prisma",
    "database:setup": "npm run database:generate && npm run database:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.5"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
